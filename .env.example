# Copy to ~/.config/vscode-copilot-telegram/.env  (Windows: C:\Users\YOU\.config\vscode-copilot-telegram\.env)
# Never save it as ".env" inside a project: that file is not read. Never commit a real token.
# Everything in the real file is also passed to the commands you approve (except the token).

# --- Required ---------------------------------------------------------------------------------

# Bot token from @BotFather. Treat it like a password.
TELEGRAM_BOT_TOKEN=123456789:AA...

# Numeric Telegram user id from @userinfobot. Only this id can approve.
TELEGRAM_USER_ID=123456789

# --- Optional (remove the "# " to use) ---------------------------------------------------------

# Audit log file. Default: ~/.vscode-copilot-telegram/audit-<project>-<hash>.jsonl. Use an absolute path.
# LOG_PATH=/Users/YOU/logs/copilot-audit.jsonl

# Where the watcher looks for VS Code chat data. Separate folders with ":" (Windows: ";").
# VSCODE_COPILOT_TELEGRAM_VSCODE_USER_DIRS=/path/to/vscode-data/User

# Proxy to reach Telegram (read by the HTTP library, not by this tool).
# HTTPS_PROXY=http://proxy.example.com:8080

# Project folder when --workspace is not passed. Don't set it here: it would apply to every project.
# WORKSPACE_ROOT=/Users/YOU/code/your-project

# Bot API address. Only for tests or a self-hosted server; your token is sent to it.
# VSCODE_COPILOT_TELEGRAM_API_BASE=http://localhost:8081
