// Copy to <your project>/.vscode/mcp.json (editor-managed "servers" format; the file allows comments).
// Replace the command with the full path to vscode-copilot-telegram in the venv where you installed it.
{
  "inputs": [
    {
      "type": "promptString",
      "id": "telegram-bot-token",
      "description": "Telegram bot token from @BotFather",
      "password": true
    },
    {
      "type": "promptString",
      "id": "telegram-user-id",
      "description": "Your numeric Telegram user id from @userinfobot"
    }
  ],
  "servers": {
    "vscode-copilot-telegram": {
      "type": "stdio",
      "command": "/Users/YOU/tools/vscode-copilot-telegram/.venv/bin/vscode-copilot-telegram",
      "args": ["--workspace", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "env": {
        "TELEGRAM_BOT_TOKEN": "${input:telegram-bot-token}",
        "TELEGRAM_USER_ID": "${input:telegram-user-id}"
      }
    }
  }
}
